{
  "manifest_version": 3,
  "name": "SLI CRM - WhatsApp Chat Sync Assistant",
  "version": "1.1.0",
  "description": "Smart, policy-safe WhatsApp Web chat sync assistant for Sri Lakshmi Industries Sales Executives.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:3000/*",
    "https://slicrm.vercel.app/*",
    "https://sli-crm-rho.vercel.app/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["dist/content.js"],
      "css": ["src/sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SLI CRM Sync Assistant"
  }
}
